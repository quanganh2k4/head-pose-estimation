# Copy file này thành deployment/.env rồi điền giá trị thật.
# File .env đã được gitignore — credential camera KHÔNG bao giờ được commit.

# Danh sách camera add lúc khởi động, phân tách bằng dấu phẩy.
# URL RTSP chứa user/password của camera IP.
CAMERA_URLS=rtsp://<user>:<password>@<camera_ip_1>:<port>/stream,rtsp://<user>:<password>@<camera_ip_2>:<port>/stream

# IP LAN thật của thiết bị Jetson — viewer bên ngoài (laptop khác trong LAN)
# dùng host này để pull video qua mediamtx.
MEDIAMTX_PUBLIC_RTSP_HOST=<jetson_lan_ip>:8554
